@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card border-0 shadow-sm villa-form-card">
            <div class="card-body p-4 p-md-5">
                <div class="villa-access-denied__icon mb-3" aria-hidden="true">&#128274;</div>
                <span class="section-eyebrow">403 &middot; Admin required</span>
                <h1 class="display-6 fw-bold mb-2">Administrator access required</h1>
                <p class="text-secondary mb-4">
                    You are signed in, but this action is restricted to administrators.
                    Please sign in with an Admin account to continue.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-2">

                    <a class="btn btn-light" asp-controller="Home" asp-action="Index">Back to home</a>
                </div>
            </div>
        </div>
    </div>
</div>
